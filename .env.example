# Copy to .env and fill in. The .env file must NEVER be committed.

# Provider: anthropic | openai | offline (no AI, no cost)
LLM_PROVIDER=anthropic
# Leave empty to use the provider's default model
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI or any compatible API (Groq, Gemini, Ollama...)
OPENAI_API_KEY=
# e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1
OPENAI_BASE_URL=

# Kaggle (only needed to download the real data)
KAGGLE_USERNAME=
KAGGLE_KEY=
